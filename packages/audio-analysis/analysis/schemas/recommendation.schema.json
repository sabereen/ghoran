{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quran-audio-analysis:recommendation:1.0.0",
  "type": "object",
  "required": ["schema_version", "data_class", "source_id", "ordinal", "content_sha256", "target_playback_lufs", "gain_db", "gain_linear", "provisional", "limiting_or_compression_used"],
  "properties": {
    "schema_version": {"const": "1.0.0"}, "data_class": {"const": "recommended"},
    "source_id": {"type": "string"}, "ordinal": {"type": "integer", "minimum": 1, "maximum": 6236},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "target_playback_lufs": {"type": "number"},
    "gain_db": {"type": ["number", "null"]},
    "gain_linear": {"type": ["number", "null"], "minimum": 0},
    "provisional": {"type": "boolean"},
    "limiting_or_compression_used": {"const": false}
  }
}
