{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quran-audio-analysis:measurement:1.0.0",
  "title": "Quran audio measurement or processing status",
  "type": "object",
  "required": ["schema_version", "source_id", "ordinal", "verse_id", "file_stem", "status", "measurement_config_sha256", "measured_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "source_id": {"type": "string", "pattern": "^[a-z]+(?:-[a-z]+)*$"},
    "ordinal": {"type": "integer", "minimum": 1, "maximum": 6236},
    "verse_id": {"type": "string", "pattern": "^[1-9][0-9]{0,2}:[1-9][0-9]{0,2}$"},
    "file_stem": {"type": "string", "pattern": "^[0-9]{6}$"},
    "status": {"enum": ["success", "missing", "invalid", "temporary_error", "http_error"]},
    "measurement_config_sha256": {"$ref": "#/$defs/sha256"},
    "measured_at": {"type": "string", "format": "date-time"},
    "url": {"type": "string", "format": "uri"},
    "measured": {
      "type": "object",
      "required": ["loudness", "duration_s", "sample_peak_dbfs", "rms_dbfs", "activity", "media", "sha256", "decoded_pcm_sha256", "quality_flags"],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "decoded_pcm_sha256": {"$ref": "#/$defs/sha256"},
        "duration_s": {"type": "number", "exclusiveMinimum": 0},
        "sample_peak_dbfs": {"$ref": "#/$defs/nullableNumber"},
        "rms_dbfs": {"$ref": "#/$defs/nullableNumber"},
        "loudness": {
          "type": "object", "required": ["integrated_lufs", "true_peak_dbtp", "lra_lu", "null_reasons"],
          "properties": {
            "integrated_lufs": {"$ref": "#/$defs/nullableNumber"},
            "true_peak_dbtp": {"$ref": "#/$defs/nullableNumber"},
            "lra_lu": {"type": ["number", "null"], "minimum": 0},
            "null_reasons": {"type": "object", "additionalProperties": {"type": "string"}}
          }
        },
        "activity": {
          "type": "object", "required": ["active_duration_s", "active_rms_dbfs", "active_intervals_s", "boundary_confidence", "automatic_trim_authorized"],
          "properties": {
            "active_duration_s": {"type": "number", "minimum": 0},
            "active_rms_dbfs": {"$ref": "#/$defs/nullableNumber"},
            "leading_low_energy_s": {"type": ["number", "null"], "minimum": 0},
            "trailing_low_energy_s": {"type": ["number", "null"], "minimum": 0},
            "active_intervals_s": {"type": "array", "items": {"type": "array", "prefixItems": [{"type": "number", "minimum": 0}, {"type": "number", "minimum": 0}], "minItems": 2, "maxItems": 2}},
            "boundary_confidence": {"enum": ["low", "moderate"]},
            "automatic_trim_authorized": {"const": false}
          }
        },
        "media": {"type": "object", "required": ["codec", "sample_rate_hz", "channels", "file_size_bytes"],
          "properties": {"sample_rate_hz": {"type": "integer", "minimum": 1}, "channels": {"type": "integer", "minimum": 1}, "file_size_bytes": {"type": "integer", "minimum": 1}}},
        "quality_flags": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "allOf": [{"if": {"properties": {"status": {"const": "success"}}}, "then": {"required": ["measured", "url"]}}],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableNumber": {"type": ["number", "null"]}
  }
}
