{
  "schema_version": "1.0.0",
  "analyzer_version": "0.1.0",
  "download": {
    "workers": 24,
    "per_host": 8,
    "timeout_s": 35,
    "attempts": 4,
    "backoff_base_s": 1,
    "max_file_bytes": 100000000,
    "minimum_host_interval_s": 0.05
  },
  "decode_timeout_s": 240,
  "loudness": {
    "minimum_lra_duration_s": 30,
    "minimum_lra_windows": 100,
    "absolute_gate_lufs": -70,
    "relative_gate_lu": -10,
    "dualmono": false,
    "metadata_interval_s": 0.1,
    "true_peak_precision_db": 0.1
  },
  "activity": {
    "frame_ms": 20,
    "noise_margin_db": 10,
    "relative_onset_db": 30,
    "hysteresis_db": 6,
    "absolute_floor_dbfs": -75,
    "bridge_ms": 180,
    "padding_ms": 120,
    "min_separation_db": 8,
    "near_silent_peak_frame_dbfs": -70
  },
  "inference": {
    "rolling_radius_verses": 15,
    "minimum_neighbors": 8,
    "minimum_active_s": 1,
    "minimum_segment_verses": 20,
    "minimum_change_lu": 3,
    "maximum_ordinal_gap": 1,
    "translation_outlier_z": 3.5,
    "recitation_outlier_z": 4.5,
    "mujawwad_outlier_z": 6,
    "mad_floor_lu": 1,
    "duration_minimum_translation_peers": 2,
    "duration_minimum_recitation_peers": 5,
    "duration_log_mad_floor": 0.25,
    "duration_outlier_z": 4,
    "duration_minimum_outlier_factor": 4,
    "recording_change_multiplier_by_kind": {
      "recitation": 1,
      "mujawwad": 1.5,
      "translation": 0.85
    }
  },
  "recommendation": {
    "targets_lufs": [
      -23,
      -20,
      -18,
      -16
    ],
    "true_peak_ceiling_dbtp": -1,
    "maximum_boost_db": 8,
    "maximum_cut_db": 18,
    "maximum_segment_correction_db": 2,
    "maximum_file_correction_db": 1,
    "segment_strength": 0.5,
    "file_strength": 0.25,
    "automatic_inferred_corrections": false,
    "target_selection_maximum_peak_limited_fraction": 0.05,
    "target_selection_maximum_extra_pair_mismatch_lu": 0.25
  }
