{
  "name": "@ghoran/audio-analysis",
  "version": "0.1.0",
  "description": "Versioned Quran audio measurements, loudness analysis and content-verified gain metadata",
  "type": "module",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./profiles": {
      "types": "./dist/profiles.d.ts",
      "import": "./dist/profiles.mjs"
    },
    "./data/*": "./data/*",
    "./schemas/*": "./analysis/schemas/*"
  },
  "sideEffects": false,
  "files": [
    "dist/**/*",
    "data/**/*",
    "analysis/scripts/**/*",
    "analysis/schemas/**/*",
    "analysis/metadata/**/*",
    "analysis/measurement-runs/**/*",
    "analysis/config.json",
    "analysis/sources.json",
    "analysis/approvals.json",
    "analysis/requirements.txt",
    "analysis/README.md",
    "analysis/DATA_DICTIONARY.fa.md",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "analyze": "python3 analysis/scripts/analyze.py",
    "extract": "python3 analysis/scripts/pipeline.py run --phase full",
    "test:analysis": "python3 -m unittest discover -s analysis/tests -v",
    "export:data": "python3 analysis/scripts/export_package.py"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sabereen/ghoran.git",
    "directory": "packages/audio-analysis"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
