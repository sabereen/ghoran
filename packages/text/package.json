{
  "name": "@ghoran/text",
  "version": "0.0.9",
  "description": "Quran text",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./json/": "./json/",
    "./fonts/": "./dist/fonts/",
    "./fonts/*": "./dist/fonts/*",
    "./json/*": "./json/*"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "generate-texts": "tsx ./scripts/generate-texts.ts",
    "generate-fonts": "tsx ./scripts/generate-fonts.ts",
    "build": "pnpm run generate-texts && tsdown && pnpm run generate-fonts",
    "prepublish": "pnpm run build"
  },
  "type": "module",
  "keywords": [],
  "author": "",
  "license": "MIT",
  "files": [
    "dist/**/*",
    "json/*.json"
  ],
  "devDependencies": {
    "@types/wawoff2": "^1.0.2",
    "mammoth": "^1.13.0",
    "wawoff2": "^2.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sabereen/ghoran.git",
    "directory": "packages/text"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
