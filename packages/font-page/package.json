{
  "name": "@ghoran/font-page",
  "version": "0.0.8",
  "description": "Quran page by page no-unicode fonts",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./fonts/": "./fonts/",
    "./fonts/*": "./fonts/*"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "prepublish": "pnpm run build"
  },
  "type": "module",
  "keywords": [
    "quran",
    "font",
    "ghoran"
  ],
  "author": "",
  "license": "MIT",
  "files": [
    "dist/**/*",
    "fonts/**/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sabereen/ghoran.git",
    "directory": "packages/font-page"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
