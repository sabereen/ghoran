{
  "name": "@ghoran/search",
  "version": "0.1.0",
  "description": "Headless Quran search, Arabic normalization and orthography-aware highlighting",
  "type": "module",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.mjs"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "default": "./dist/worker.mjs"
    }
  },
  "sideEffects": [
    "./dist/worker.mjs"
  ],
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "bench": "node --expose-gc bench/search.mjs"
  },
  "dependencies": {
    "@ghoran/metadata": "workspace:*",
    "@ghoran/text": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sabereen/ghoran.git",
    "directory": "packages/search"
  },
  "license": "MIT",
  "keywords": [
    "quran",
    "arabic",
    "search",
    "highlight",
    "worker"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
