{
  "name": "@ghoran/translation",
  "version": "0.0.9",
  "description": "Quran translations",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./json/": "./json/",
    "./json/*": "./json/*"
  },
  "sideEffects": false,
  "scripts": {
    "generate-texts": "tsx ./scripts/fetch-from-tanzil.ts",
    "build": "pnpm run prepare-data && tsdown",
    "prepublish": "pnpm run build",
    "prepare-data": "tsx ./scripts/prepare-data.ts"
  },
  "type": "module",
  "keywords": [],
  "author": "",
  "license": "MIT",
  "files": [
    "dist/**/*",
    "json/**/*.json"
  ],
  "devDependencies": {
    "@ghoran/translation-source": "npm:@ghoran/translation@0.0.9"
  }
}
